# ===== 大模型凭据 =====
# 智谱开放平台 Key（https://open.bigmodel.cn/ 控制台获取）
# 不填也能跑：Agent 会自动降级到规则路由模式
ZHIPU_API_KEY=

# 智谱 OpenAI 兼容接口地址（默认即可，一般不用改）
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 模型名称。免费好用的推荐 glm-4-flash，能力更强可选 glm-4-plus
ZHIPU_MODEL=glm-4-flash

# ===== Agent 运行模式 =====
# auto  = 有 Key 走大模型，失败自动降级到规则路由（推荐）
# llm   = 只用大模型
# rule  = 只用规则路由，完全离线
AGENT_BACKEND=auto

# 模型供应商：zhipu-openai（推荐，走智谱 OpenAI 兼容端点）| openai
MODEL_PROVIDER=zhipu-openai

# ===== 可选：改用 OpenAI =====
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ===== 其它 =====
MODEL_TIMEOUT_SEC=60
MODEL_MAX_RETRIES=3
MODEL_TEMPERATURE=0.2
AGENT_MAX_STEPS=8
MAX_UPLOAD_MB=20
DEFAULT_CN_FONT=宋体
